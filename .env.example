# ===== Domain (ใช้เฉพาะตอน deploy prod ด้วย deploy/docker-compose.prod.yml) =====
CHAT_DOMAIN=llm.example.com          # หน้าแชท Open WebUI
API_DOMAIN=llm-api.example.com       # LiteLLM API + /ui
ACME_EMAIL=you@example.com           # แจ้งเตือน cert Let's Encrypt

# ===== Ports (host) — ใช้เฉพาะตอน dev =====
LITELLM_PORT=4000
OPENWEBUI_PORT=3000

# ===== Postgres (เก็บ virtual key / spend log ของ LiteLLM) =====
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=            # openssl rand -hex 24

# ===== LiteLLM =====
LITELLM_MASTER_KEY=sk-        # ต้องขึ้นต้น sk- : openssl rand -hex 24
LITELLM_SALT_KEY=             # ใช้เข้ารหัส key ที่เก็บใน DB — ตั้งครั้งเดียว ห้ามเปลี่ยนทีหลัง
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=          # login หน้า http://<host>:4000/ui

# ===== Open WebUI =====
WEBUI_SECRET_KEY=             # openssl rand -hex 32
WEBUI_NAME="LLM Gateway"
# key ที่ Open WebUI ใช้ยิงเข้า LiteLLM — แนะนำให้ใช้ virtual key (scripts/gen-key.sh)
# ไม่ใช่ master key
OPENWEBUI_LITELLM_KEY=sk-

# ===== Provider credentials =====
# ใส่เท่าที่ใช้ ที่เหลือปล่อยว่างได้ — ดูตัวอย่าง config ใน litellm/config.yaml

# --- เจ้าที่มี free tier ---
# HuggingFace — https://huggingface.co/settings/tokens
#   (ติ๊ก "Make calls to Inference Providers")
HF_TOKEN=
# Groq — เร็วที่สุด https://console.groq.com
GROQ_API_KEY=
# Cerebras — 1M token/วัน https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Google AI Studio — context 1M https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Mistral — 1B token/เดือน https://console.mistral.ai
MISTRAL_API_KEY=
# OpenRouter — โมเดล :free หลายสิบตัว https://openrouter.ai/keys
OPENROUTER_API_KEY=
# GitHub Models — ใช้ PAT เดิมได้ https://github.com/marketplace/models
GITHUB_API_KEY=
# NVIDIA NIM — https://build.nvidia.com
NVIDIA_NIM_API_KEY=
# SambaNova — https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
# Cloudflare Workers AI — ต้องมี account id ด้วย https://dash.cloudflare.com
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Ollama Cloud — โมเดลใหญ่โดยไม่ต้องมี GPU https://ollama.com/settings/keys
OLLAMA_API_KEY=
# OKMD AI Playground (ไทย) — key เดียวได้ 24 โมเดลรวม Claude/GPT/Gemini/Grok
# สร้างที่ playground.okmd.or.th → API Platform
OKMD_API_KEY=
# ThaiLLM — โมเดลภาษาไทยของไทย (OpenThaiGPT, Pathumma, Typhoon, THaLLE)
# https://thaillm.or.th
THAILLM_API_KEY=
# Typhoon ตรงจาก SCB 10X — https://playground.opentyphoon.ai (ฟรี ~50 req/min, ctx 8K)
TYPHOON_API_KEY=
# SEA-LION ตรงจาก AI Singapore — https://sea-lion.ai (trial ฟรี 10 req/min)
SEALION_API_KEY=
# Chinda Thai LLM 4B (iApp) — https://iapp.co.th
IAPP_API_KEY=
# KNPLabs (ไทย) — https://play.knplabai.com  ฟรีกับจ่ายเงินคนละ host คนละ key
KNPLAB_API_KEY=
KNPLAB_STREAM_API_KEY=
# Float16.cloud (GPU cloud ไทย) — https://float16.cloud
# endpoint แยกต่อลูกค้า ต้องตั้ง base URL เองด้วย
FLOAT16_API_KEY=
FLOAT16_BASE_URL=

# --- เจ้าที่เสียเงินอย่างเดียว ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- self-hosted backends (รันเอง ไม่ใช่ Ollama Cloud ด้านบน) ---
VLLM_API_BASE=
OLLAMA_API_BASE=
